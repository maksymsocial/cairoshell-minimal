<?xml version="1.0" encoding="utf-8"?>
<objectModel:CairoAppBarWindow
    xmlns:objectModel="clr-namespace:CairoDesktop.Infrastructure.ObjectModel;assembly=CairoDesktop.Infrastructure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:self="clr-namespace:CairoDesktop.Taskbar"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:tasks="clr-namespace:ManagedShell.WindowsTasks;assembly=ManagedShell.WindowsTasks"
    x:Class="CairoDesktop.Taskbar.MinimalTaskbar"
    x:Name="MinTaskbarWindow"
    Title="MinimalTaskbar"
    Left="0"
    ShowActivated="False"
    AllowDrop="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <!-- Brushes and fonts are replaced from settings in code (applyLook) -->
        <SolidColorBrush x:Key="MinBg" Color="#D6D6D6" />
        <SolidColorBrush x:Key="MinFg" Color="#000000" />
        <SolidColorBrush x:Key="MinActiveBg" Color="#F4F4F4" />
        <SolidColorBrush x:Key="MinHoverBg" Color="#E4E4E4" />
        <SolidColorBrush x:Key="MinBorder" Color="#9A9A9A" />
        <SolidColorBrush x:Key="MinFlashBg" Color="#F2C46B" />
        <SolidColorBrush x:Key="MinActiveFg" Color="#000000" />
        <SolidColorBrush x:Key="MinStartBg" Color="Transparent" />
        <SolidColorBrush x:Key="MinStartFg" Color="#000000" />
        <SolidColorBrush x:Key="MinTaskBg" Color="Transparent" />
        <SolidColorBrush x:Key="MinTaskFg" Color="#000000" />
        <SolidColorBrush x:Key="MinTaskAltBg" Color="Transparent" />
        <SolidColorBrush x:Key="MinTaskAltFg" Color="#000000" />
        <SolidColorBrush x:Key="MinUserBg" Color="Transparent" />
        <SolidColorBrush x:Key="MinUserFg" Color="#000000" />
        <FontFamily x:Key="MinFontFamily">Segoe UI</FontFamily>
        <sys:Double x:Key="MinFontSize">12</sys:Double>
        <sys:Double x:Key="MinIconSize">14</sys:Double>
        <sys:Double x:Key="MinTrayCellWidth">18</sys:Double>

        <!-- Plain flat button: no gaps, no rounded bits, just a background change -->
        <Style x:Key="MinFlatButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource MinFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MinBorder}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinActiveBg}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinActiveBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task button: full-height plain button, icon + title, divider on the right -->
        <DataTemplate x:Key="MinTaskTemplate" DataType="{x:Type tasks:ApplicationWindow}">
            <Button x:Name="btn"
                    Click="TaskButton_Click"
                    PreviewMouseDown="TaskButton_PreviewMouseDown"
                    MouseRightButtonUp="TaskButton_MouseRightButtonUp"
                    ToolTip="{Binding Path=Title}"
                    ToolTipService.InitialShowDelay="700"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="0"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource MinTaskBg}"
                                BorderBrush="{DynamicResource MinBorder}"
                                BorderThickness="0,0,1,0"
                                Padding="7,0">
                            <Grid>
                            <DockPanel LastChildFill="True">
                                <Image Source="{Binding Path=Icon}"
                                       DockPanel.Dock="Left"
                                       Width="{DynamicResource MinIconSize}" Height="{DynamicResource MinIconSize}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="txt"
                                           Text="{Binding Path=Title}"
                                           Foreground="{DynamicResource MinTaskFg}"
                                           FontFamily="{DynamicResource MinFontFamily}"
                                           FontSize="{DynamicResource MinFontSize}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- every second button: alternate colors (listed first so hover/active win) -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinTaskAltBg}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource MinTaskAltFg}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinHoverBg}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=State}" Value="Flashing">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinFlashBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=State}" Value="Active">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MinActiveBg}" />
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource MinActiveFg}" />
                                <Setter TargetName="txt" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Tray icon -->
        <DataTemplate x:Key="MinTrayIconTemplate">
            <Border Background="Transparent"
                    Width="{DynamicResource MinTrayCellWidth}"
                    VerticalAlignment="Stretch"
                    ToolTip="{Binding Path=Title}"
                    MouseDown="TrayIcon_MouseDown"
                    MouseUp="TrayIcon_MouseUp"
                    MouseEnter="TrayIcon_MouseEnter"
                    MouseLeave="TrayIcon_MouseLeave"
                    MouseMove="TrayIcon_MouseMove">
                <Image Source="{Binding Path=Icon}"
                       Width="{DynamicResource MinIconSize}" Height="{DynamicResource MinIconSize}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Loaded="TrayIconImage_Loaded"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="bdrRoot"
            Background="{DynamicResource MinBg}"
            BorderBrush="{DynamicResource MinBorder}"
            BorderThickness="0"
            TextElement.Foreground="{DynamicResource MinFg}"
            TextElement.FontFamily="{DynamicResource MinFontFamily}"
            TextElement.FontSize="{DynamicResource MinFontSize}"
            RenderOptions.ClearTypeHint="Enabled"
            MouseRightButtonUp="Panel_MouseRightButtonUp">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </Border.RenderTransform>

        <DockPanel LastChildFill="True">
            <!-- Start: square, full height -->
            <Button x:Name="btnStart"
                    DockPanel.Dock="Left"
                    Style="{StaticResource MinFlatButton}"
                    Click="Start_Click"
                    ToolTip="Start"
                    Padding="0"
                    Background="{DynamicResource MinStartBg}"
                    BorderThickness="0,0,1,0">
                <Grid x:Name="gridStartGlyph" Width="10" Height="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="1" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="{DynamicResource MinStartFg}" />
                    <Rectangle Grid.Row="0" Grid.Column="2" Fill="{DynamicResource MinStartFg}" />
                    <Rectangle Grid.Row="2" Grid.Column="0" Fill="{DynamicResource MinStartFg}" />
                    <Rectangle Grid.Row="2" Grid.Column="2" Fill="{DynamicResource MinStartFg}" />
                </Grid>
            </Button>

            <!-- Show desktop: the thin strip at the far right -->
            <Button x:Name="btnShowDesktop"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MinFlatButton}"
                    Click="ShowDesktop_Click"
                    ToolTip="Show desktop"
                    Width="8"
                    Padding="0"
                    BorderThickness="0" />

            <!-- Clock -->
            <ToggleButton x:Name="btnClock"
                          DockPanel.Dock="Right"
                          Style="{StaticResource MinFlatButton}"
                          Click="Clock_Click"
                          Padding="8,0"
                          BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <self:MinRing x:Name="ringClockTimer" Width="10" Height="10" Thickness="1.8" Stroke="{DynamicResource MinFg}" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
                    <TextBlock x:Name="txtClockTimer" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                    <TextBlock x:Name="txtClock" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="popClock"
                   PlacementTarget="{Binding ElementName=btnClock}"
                   Placement="Top"
                   HorizontalOffset="0"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   IsOpen="{Binding ElementName=btnClock, Path=IsChecked}"
                   Opened="AnyPopup_Opened"
                   Closed="AnyPopup_Closed">
                <Border Background="{DynamicResource MinBg}" BorderBrush="{DynamicResource MinBorder}" BorderThickness="1" Width="236"
                        TextElement.Foreground="{DynamicResource MinFg}"
                        TextElement.FontFamily="{DynamicResource MinFontFamily}"
                        TextElement.FontSize="{DynamicResource MinFontSize}"
                        TextOptions.TextFormattingMode="Display"
                        PreviewKeyDown="ClockPopup_PreviewKeyDown">
                    <Border.Resources>
                        <Style x:Key="MinSmallButton" TargetType="ButtonBase" BasedOn="{StaticResource MinFlatButton}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                        </Style>
                        <Style x:Key="MinPillButton" TargetType="ButtonBase" BasedOn="{StaticResource MinFlatButton}">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Background" Value="{DynamicResource MinHoverBg}" />
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <DockPanel>
                        <!-- tabs -->
                        <UniformGrid DockPanel.Dock="Top" Rows="1" Height="20">
                            <RadioButton x:Name="tabDate" GroupName="clockTab" Style="{StaticResource MinFlatButton}" Content="Date" IsChecked="True" Checked="ClockTab_Checked" />
                            <RadioButton x:Name="tabTimers" GroupName="clockTab" Style="{StaticResource MinFlatButton}" Content="Timers" Checked="ClockTab_Checked" />
                            <RadioButton x:Name="tabStopwatch" GroupName="clockTab" Style="{StaticResource MinFlatButton}" Content="Stopwatch" Checked="ClockTab_Checked" />
                        </UniformGrid>

                        <Grid Margin="8,8,8,8">
                            <!-- date: small flat month grid -->
                            <StackPanel x:Name="pnlDate" MouseWheel="Calendar_MouseWheel">
                                <TextBlock x:Name="txtClockDate" FontWeight="SemiBold" Margin="1,0,0,5" />
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource MinSmallButton}" Click="CalPrev_Click" ToolTip="Previous month">
                                        <Path Data="M 4 0 L 0 4 L 4 8" Stroke="{DynamicResource MinFg}" StrokeThickness="1.2" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MinSmallButton}" Click="CalNext_Click" ToolTip="Next month">
                                        <Path Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource MinFg}" StrokeThickness="1.2" />
                                    </Button>
                                    <Button Style="{StaticResource MinFlatButton}" Click="CalToday_Click" ToolTip="Back to today" Padding="0">
                                        <TextBlock x:Name="txtCalMonth" />
                                    </Button>
                                </DockPanel>
                                <UniformGrid x:Name="gridCalHead" Columns="7" Opacity="0.6" Margin="0,0,0,2" />
                                <UniformGrid x:Name="gridCalDays" Columns="7" />
                            </StackPanel>

                            <!-- timers -->
                            <StackPanel x:Name="pnlTimers" Visibility="Collapsed">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MinPillButton}" Width="26" Padding="0" Margin="4,2,2,2" Click="TimerAdd_Click" ToolTip="Add timer (Enter)">
                                        <Path Data="M 4 0 L 4 8 M 0 4 L 8 4" Stroke="{DynamicResource MinFg}" StrokeThickness="1.2" />
                                    </Button>
                                    <Grid>
                                        <TextBox x:Name="txtTimerInput"
                                                 Height="22"
                                                 Margin="2"
                                                 Padding="5,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource MinHoverBg}"
                                                 Foreground="{DynamicResource MinFg}"
                                                 CaretBrush="{DynamicResource MinFg}"
                                                 SelectionBrush="{DynamicResource MinActiveBg}"
                                                 BorderThickness="0"
                                                 FontFamily="{DynamicResource MinFontFamily}"
                                                 FontSize="{DynamicResource MinFontSize}"
                                                 PreviewMouseDown="TimerInput_PreviewMouseDown"
                                                 TextChanged="TimerInput_TextChanged"
                                                 KeyDown="TimerInput_KeyDown" />
                                        <TextBlock x:Name="txtTimerHint" Text="5m, 1:30, 1h20m tea" Opacity="0.5" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                </DockPanel>
                                <UniformGrid Rows="1" Margin="0,0,0,8">
                                    <Button Style="{StaticResource MinPillButton}" Padding="0" Content="1m" Tag="1" Click="TimerQuick_Click" />
                                    <Button Style="{StaticResource MinPillButton}" Padding="0" Content="5m" Tag="5" Click="TimerQuick_Click" />
                                    <Button Style="{StaticResource MinPillButton}" Padding="0" Content="10m" Tag="10" Click="TimerQuick_Click" />
                                    <Button Style="{StaticResource MinPillButton}" Padding="0" Content="25m" Tag="25" Click="TimerQuick_Click" />
                                    <Button Style="{StaticResource MinPillButton}" Padding="0" Content="1h" Tag="60" Click="TimerQuick_Click" />
                                </UniformGrid>
                                <TextBlock x:Name="txtTimersEmpty" Text="No timers" Opacity="0.5" HorizontalAlignment="Center" Margin="0,4" />
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="lstTimers" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type self:MinTimer}">
                                                <Border x:Name="row" Height="24" Margin="2,0" Padding="2,0" Background="Transparent">
                                                    <DockPanel>
                                                        <self:MinRing x:Name="ring" DockPanel.Dock="Left" Width="12" Height="12" Thickness="2" Margin="3,0,2,0"
                                                                      Progress="{Binding Progress}" Stroke="{DynamicResource MinFg}" VerticalAlignment="Center" />
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource MinSmallButton}" Click="TimerRemove_Click" ToolTip="Remove">
                                                            <Path Data="M 0 0 L 6 6 M 6 0 L 0 6" Stroke="{DynamicResource MinFg}" StrokeThickness="1.2" />
                                                        </Button>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource MinSmallButton}" Click="TimerToggle_Click" ToolTip="{Binding ToggleTip}">
                                                            <Grid>
                                                                <Path x:Name="icoPause" Data="M 0 0 L 0 7 M 4 0 L 4 7" Stroke="{DynamicResource MinFg}" StrokeThickness="1.5" />
                                                                <Path x:Name="icoPlay" Data="M 0 0 L 6 3.5 L 0 7 Z" Fill="{DynamicResource MinFg}" Visibility="Collapsed" />
                                                            </Grid>
                                                        </Button>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource MinTaskAltBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                        <Setter TargetName="icoPause" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="icoPlay" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource MinFlashBg}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- stopwatch -->
                            <StackPanel x:Name="pnlStopwatch" Visibility="Collapsed">
                                <TextBlock x:Name="txtStopwatch" Text="0:00.0" FontSize="24" FontWeight="Light" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                <UniformGrid Rows="1" Margin="0,0,0,8">
                                    <Button x:Name="btnStopwatchStart" Style="{StaticResource MinPillButton}" Content="Start" Click="StopwatchStart_Click" />
                                    <Button x:Name="btnStopwatchLap" Style="{StaticResource MinPillButton}" Content="Lap" Click="StopwatchLap_Click" />
                                    <Button Style="{StaticResource MinPillButton}" Content="Reset" Click="StopwatchReset_Click" />
                                </UniformGrid>
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="lstLaps" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="row" Height="22" Margin="2,0" Background="Transparent">
                                                    <DockPanel Margin="6,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Split}" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource MinTaskAltBg}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Popup>

            <!-- User: name, click for lock / sleep / hibernate / shut down -->
            <Button x:Name="btnUser"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MinFlatButton}"
                    Background="{DynamicResource MinUserBg}"
                    Click="User_Click"
                    Padding="8,0">
                <TextBlock x:Name="txtUser" Foreground="{DynamicResource MinUserFg}" VerticalAlignment="Center" />
            </Button>

            <!-- Tray: [collapse toggle][^ hidden icons][icons] -->
            <Border x:Name="pnlTray" DockPanel.Dock="Right" BorderBrush="{DynamicResource MinBorder}" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="btnTrayCollapse"
                                  Style="{StaticResource MinFlatButton}"
                                  Click="TrayCollapse_Click"
                                  Padding="0"
                                  Width="7"
                                  ToolTip="Hide tray icons">
                        <Path x:Name="pathTrayCollapse" Data="M 0 0 L 3 3 L 0 6" Stroke="{DynamicResource MinFg}" StrokeThickness="1" />
                    </ToggleButton>
                    <ToggleButton x:Name="btnTrayOverflow"
                                  Style="{StaticResource MinFlatButton}"
                                  Padding="4,0"
                                  ToolTip="Hidden icons"
                                  Visibility="Collapsed">
                        <Path Data="M 0 5 L 4 0 L 8 5" Stroke="{DynamicResource MinFg}" StrokeThickness="1.3" />
                    </ToggleButton>
                    <Popup x:Name="popTrayOverflow"
                           PlacementTarget="{Binding ElementName=btnTrayOverflow}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           IsOpen="{Binding ElementName=btnTrayOverflow, Path=IsChecked}"
                           Opened="AnyPopup_Opened"
                           Closed="AnyPopup_Closed">
                        <Border Background="{DynamicResource MinBg}" BorderBrush="{DynamicResource MinBorder}" BorderThickness="1" Padding="2" MaxWidth="180">
                            <ItemsControl x:Name="lstTrayHidden" ItemTemplate="{StaticResource MinTrayIconTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Popup>
                    <ItemsControl x:Name="lstTray"
                                  Margin="0,0,2,0"
                                  ItemTemplate="{StaticResource MinTrayIconTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                </StackPanel>
            </Border>

            <!-- Tasks -->
            <ItemsControl x:Name="lstTasks"
                          AlternationCount="2"
                          ItemTemplate="{StaticResource MinTaskTemplate}"
                          Margin="0"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <self:MinimalTaskPanel MaxItemWidth="{Binding Path=ButtonMaxWidth, ElementName=MinTaskbarWindow}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </Border>
</objectModel:CairoAppBarWindow>
